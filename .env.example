PORT=8787
APP_BASE_URL=http://localhost:5173
# Leave the command and args empty to use the bundled Harness ACP profile.
DEEPSEEK_HARNESS_COMMAND=
DEEPSEEK_HARNESS_ARGS=
# DeepSeek Harness reads its provider credentials from DSH_HOME.
DSH_HOME=
DEEPSEEK_API_KEY=
# Configure QCC as an MCP server. The official page supports 10 Streamable HTTP servers.
QCC_MCP_API_KEY=
QCC_MCP_SERVERS=
QCC_MCP_COMMAND=
QCC_MCP_ARGS=[]
QCC_MCP_ENV={}
QCC_MCP_URL=
QCC_MCP_HEADERS={}
# Optional: set a CJK-capable TTF/TTC file for Chinese PDF text.
PDF_FONT_PATH=
